#include <windows.h>

#define IDD_SETTINGS 101
#define IDC_VERSION 1001
#define IDC_MIRROR 1002
#define IDC_SKIP_INTRO 1003

1 RT_MANIFEST "screensaver/windows/matrix/matrix.manifest"

IDD_SETTINGS DIALOGEX 0, 0, 245, 112
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Matrix Settings"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX        "Appearance", -1, 7, 7, 231, 70
    LTEXT           "Version:", -1, 18, 24, 48, 10
    COMBOBOX        IDC_VERSION, 76, 21, 148, 80,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Enable mirror effect", IDC_MIRROR, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 76, 44, 148, 12
    CONTROL         "Skip intro", IDC_SKIP_INTRO, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 76, 60, 148, 12
    DEFPUSHBUTTON   "OK", IDOK, 128, 88, 52, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 186, 88, 52, 16
END
